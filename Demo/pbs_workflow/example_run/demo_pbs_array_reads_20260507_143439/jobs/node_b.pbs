set -euo pipefail
cd "${PBS_O_WORKDIR}"

mkdir -p "/home/silvia/workflow_editor/workflow-editor/runs/demo_pbs_array_reads_20260507_143439/results/work/pbs_summarize_reads"
cd "/home/silvia/workflow_editor/workflow-editor/runs/demo_pbs_array_reads_20260507_143439/results/work/pbs_summarize_reads"
mkdir -p "/home/silvia/workflow_editor/workflow-editor/runs/demo_pbs_array_reads_20260507_143439/results/out"
export LC_ALL=C

# load modules
ml purge
ml python/3.11

python3 /home/silvia/workflow_editor/workflow-editor/Demo/pbs_workflow/tools/pbs_summarize_reads.py --filtered-dir /home/silvia/workflow_editor/workflow-editor/runs/demo_pbs_array_reads_20260507_143439/results/out/filtered_reads --out /home/silvia/workflow_editor/workflow-editor/runs/demo_pbs_array_reads_20260507_143439/results/out/pbs_read_summary.txt
